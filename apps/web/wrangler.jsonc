{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "localify-web",
  "main": ".open-next/worker.js",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "localify.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.localify.dev",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-04-26",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "localify-web"
    }
  ]
}
