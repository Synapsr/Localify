# Copy to `.env` and fill in the values you need. Never commit `.env`.
# None of these are required to build and run Localify locally
# (`cargo build`, `pnpm tauri:dev`, `pnpm web:dev`). They are only used for signed
# releases and for the website's analytics and download host.

# --- Desktop release ---
# Maintainers keep these in Infisical, project localify, folder /release:
#   infisical run --env prod --path /release -- pnpm tauri:build
# The certificate's name or, safer when the name has accents, its SHA-1 hash.
APPLE_SIGNING_IDENTITY=
# Unlocks a keychain kept only for releases, on a Mac that has one.
LOCALIFY_RELEASE_KEYCHAIN_PASSWORD=
# Notarize with an App Store Connect API key. The key file defaults to
# ~/.appstoreconnect/private_keys/AuthKey_<APPLE_API_KEY>.p8
APPLE_API_KEY=
APPLE_API_ISSUER=
APPLE_API_KEY_PATH=
# ...or with an Apple ID and an app-specific password.
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
# Signs the updater archive. Defaults to ~/.tauri/localify-updater.key
TAURI_SIGNING_PRIVATE_KEY=
LOCALIFY_UPDATER_BASE_URL=
LOCALIFY_R2_BUCKET=
# Public PostHog values for the app's analytics and error reports. Without a token,
# the build sends nothing.
VITE_PUBLIC_POSTHOG_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# --- Website (apps/web): public values, read at build time ---
# Maintainers keep these in Infisical, project localify, folder /web:
#   infisical run --env prod --path /web -- pnpm web:deploy
# PostHog and its cookie banner run in production when a token is set. The host defaults
# to https://us.i.posthog.com. DISABLED=true turns them off, DEBUG=true turns them on in dev.
NEXT_PUBLIC_POSTHOG_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_DISABLED=
NEXT_PUBLIC_POSTHOG_DEBUG=
# Defaults to https://downloads.localify.dev
NEXT_PUBLIC_LOCALIFY_DOWNLOADS_BASE_URL=
