# Copy to `.env` and fill in the values you need. Never commit `.env`.
# None of these are required to build and run Localify locally
# (`cargo build`, `pnpm tauri:dev`). They are only used for signed
# releases and for the website checkout flow.

# --- Desktop release: macOS signing and notarization ---
APPLE_SIGNING_IDENTITY=
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=
APPLE_CERTIFICATE=
APPLE_CERTIFICATE_PASSWORD=
KEYCHAIN_PASSWORD=

# --- Desktop release: updater publishing (Cloudflare R2) ---
LOCALIFY_UPDATER_BASE_URL=
LOCALIFY_R2_BUCKET=

# --- Website (apps/web): Stripe checkout ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PERSONAL=

# --- Website (apps/web): Keygen license fulfillment ---
LOCALIFY_KEYGEN_API_URL=
LOCALIFY_KEYGEN_ACCOUNT_ID=
LOCALIFY_KEYGEN_ADMIN_TOKEN=
LOCALIFY_KEYGEN_POLICY_SINGLE_ID=
LOCALIFY_KEYGEN_POLICY_PERSONAL_ID=
