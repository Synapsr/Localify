{
  "name": "localify-workspace",
  "private": true,
  "version": "0.1.9",
  "type": "module",
  "scripts": {
    "dev": "pnpm desktop:dev",
    "build": "pnpm desktop:build",
    "typecheck": "pnpm desktop:typecheck",
    "lint": "pnpm desktop:lint",
    "lint:fix": "pnpm desktop:lint:fix",
    "format": "pnpm desktop:format",
    "format:check": "pnpm desktop:format:check",
    "desktop:dev": "vite",
    "desktop:build": "vite build",
    "desktop:typecheck": "tsc --noEmit",
    "desktop:lint": "oxlint",
    "desktop:lint:fix": "oxlint --fix",
    "desktop:format": "oxfmt",
    "desktop:format:check": "oxfmt --check",
    "web:dev": "pnpm --filter @localify/web dev",
    "web:build": "pnpm --filter @localify/web build",
    "web:build:cloudflare": "node scripts/web-cloudflare.mjs build",
    "web:cf-typegen": "pnpm --filter @localify/web cf-typegen",
    "web:deploy": "pnpm --filter @localify/web run deploy",
    "web:preview": "pnpm --filter @localify/web run preview",
    "web:start": "pnpm --filter @localify/web start",
    "web:upload": "pnpm --filter @localify/web run upload",
    "web:typecheck": "pnpm --filter @localify/web typecheck",
    "desktop:prepare-sidecar": "node scripts/prepare-tauri-sidecar.mjs --release",
    "desktop:check-version-sync": "node scripts/check-desktop-version-sync.mjs",
    "desktop:postprocess-macos-bundles": "bash scripts/postprocess-macos-bundles.sh",
    "desktop:publish": "node scripts/publish-desktop-release.mjs",
    "desktop:publish-updater": "node scripts/publish-updater-manifest.mjs",
    "desktop:publish-r2": "node scripts/publish-updater-r2.mjs",
    "publish:update:r2": "pnpm desktop:publish-r2",
    "version:desktop": "node scripts/set-desktop-version.mjs",
    "tauri": "tauri",
    "tauri:dev": "LOCALIFY_PROFILE=dev LOCALIFY_CLI_PATH=\"$PWD/target/debug/localify\" tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "bash scripts/run-tauri-build.sh",
    "tauri:package": "pnpm tauri:build"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@mynaui/icons-react": "^0.4.2",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-form": "^1.29.0",
    "@tanstack/react-hotkeys": "^0.9.1",
    "@tanstack/react-query": "^5.99.0",
    "@tanstack/react-router": "^1.168.19",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-global-shortcut": "^2.3.1",
    "@tauri-apps/plugin-opener": "^2.5.3",
    "@vitejs/plugin-react": "^5.2.0",
    "agentation": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.38.0",
    "next-themes": "^0.4.6",
    "posthog-js": "^1.372.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tanstack/router-plugin": "^1.167.22",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "oxfmt": "^0.45.0",
    "oxlint": "^1.60.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
