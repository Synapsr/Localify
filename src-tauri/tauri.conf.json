{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Localify Desktop",
  "version": "0.1.0",
  "identifier": "com.localify.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "DeveloperTool",
    "shortDescription": "Local HTTPS and custom domains for local development.",
    "externalBin": ["binaries/localify"],
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
