{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Localify Desktop",
  "version": "0.1.3",
  "identifier": "com.localify.desktop",
  "build": {
    "beforeDevCommand": "pnpm desktop:dev",
    "beforeBuildCommand": "pnpm desktop:build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 1280,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local HTTPS and custom domains for local development.",
    "externalBin": [
      "binaries/localify"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["localify"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzRTZGMkU1NTQ2NThBODEKUldTQmltVlU1ZkxtODBvQW1xTnVTSmVnTFZOa2VYU3FYdWI1dU1NaVFkcWUrd2VKR1ZjYytMTnQK",
      "endpoints": [
        "https://updates.localify.invalid/latest.json"
      ]
    }
  }
}
